+/// Uses the existing certified linear convex walk before the pair-wide
+/// collinearity scan. The walk rejects every endpoint or collinear ambiguity;
+/// only a non-degenerate result can bypass the conservative pair gate.
+fn try_linear_strict_convex_boolean(
+    request: BooleanRequestD<'_>,
+) -> Option<Result<PathsD, Error>> {
+    if request.subjects.len() != 1
+        || request.clips.len() != 1
+        || !eligible(request.subjects, request.clips)
+    {
+        return None;
+    }
+    let subject = request.subjects[0].as_slice();
+    let clip = request.clips[0].as_slice();
+    if subject.len() < 3
+        || clip.len() < 3
+        || !strict_convex(subject)
+        || !strict_convex(clip)
+        || !keyable_path(subject)
+        || !keyable_path(clip)
+        || !fill_rule_accepts_ring(subject, request.fill_rule)
+        || !fill_rule_accepts_ring(clip, request.fill_rule)
+        || area2(subject) <= 0.0
+        || area2(clip) <= 0.0
+    {
+        return None;
+    }
+
+    let walk = convex_boundary_walk(
+        subject,
+        clip,
+        request.clip_type == ClipType::Intersection,
+        request.clip_type != ClipType::Intersection,
+    );
+    if walk.degenerate {
+        return None;
+    }
+    if request.clip_type == ClipType::Intersection {
+        return Some(Ok(walk.output));
+    }
+
+    let ConvexWalk {
+        subject_splits,
+        clip_splits,
+        subject_inside,
+        clip_inside,
+        ..
+    } = walk;
+    let use_inside_hints =
+        subject_splits.iter().chain(&clip_splits).any(|values| values.len() > 2);
+    convex_boolean_from_splits(
+        subject,
+        clip,
+        request.clip_type,
+        subject_splits,
+        clip_splits,
+        if use_inside_hints { &subject_inside } else { &[] },
+        if use_inside_hints { &clip_inside } else { &[] },
+    )
+    .map(Ok)
+}
