+fn axis_aligned_rectangle(path: &[Point]) -> Option<AxisAlignedRectangle> {
+    if path.len() != 4 {
+        return None;
+    }
+    if path.iter().any(|point| {
+        !point.x.is_finite()
+            || !point.y.is_finite()
+            || point.x.abs() > MAX_COORDINATE
+            || point.y.abs() > MAX_COORDINATE
+    }) {
+        return None;
+    }
+    let keys = [key(path[0])?, key(path[1])?, key(path[2])?, key(path[3])?];
+    let min_x_key = keys.iter().map(|point| point.x).min()?;
+    let max_x_key = keys.iter().map(|point| point.x).max()?;
+    let min_y_key = keys.iter().map(|point| point.y).min()?;
+    let max_y_key = keys.iter().map(|point| point.y).max()?;
+    if min_x_key == max_x_key || min_y_key == max_y_key {
+        return None;
+    }
+
+    let min_x = keyed_coordinate_value(path, &keys, min_x_key, true)?;
+    let max_x = keyed_coordinate_value(path, &keys, max_x_key, true)?;
+    let min_y = keyed_coordinate_value(path, &keys, min_y_key, false)?;
+    let max_y = keyed_coordinate_value(path, &keys, max_y_key, false)?;
+    let mut corners = 0_u8;
+    for index in 0..4 {
+        let point = keys[index];
+        let next = keys[(index + 1) % 4];
+        if (point.x == next.x) == (point.y == next.y) {
+            return None;
+        }
+        let x_index = if point.x == min_x_key {
+            0
+        } else if point.x == max_x_key {
+            1
+        } else {
+            return None;
+        };
+        let y_index = if point.y == min_y_key {
+            0
+        } else if point.y == max_y_key {
+            1
+        } else {
+            return None;
+        };
+        let corner = 1_u8 << (x_index + 2 * y_index);
+        if corners & corner != 0 {
+            return None;
+        }
+        corners |= corner;
+    }
+    if corners != 0b1111 {
+        return None;
+    }
+
+    Some(AxisAlignedRectangle {
+        min_x: GridCoordinate { key: min_x_key, value: min_x },
+        min_y: GridCoordinate { key: min_y_key, value: min_y },
+        max_x: GridCoordinate { key: max_x_key, value: max_x },
+        max_y: GridCoordinate { key: max_y_key, value: max_y },
+    })
+}
+
+fn keyed_coordinate_value(
+    path: &[Point],
+    keys: &[PointKey; 4],
+    target: i64,
+    x_axis: bool,
+) -> Option<f64> {
+    let mut value: Option<f64> = None;
+    for (point, key) in path.iter().zip(keys) {
+        let (key, candidate) =
+            if x_axis { (key.x, point.x + 0.0) } else { (key.y, point.y + 0.0) };
+        if key != target {
+            continue;
+        }
+        if value.is_some_and(|known| known.to_bits() != candidate.to_bits()) {
+            return None;
+        }
+        value = Some(candidate);
+    }
+    value
+}
+
+fn tiny_coordinates(
+    first_min: GridCoordinate,
+    first_max: GridCoordinate,
+    second_min: GridCoordinate,
+    second_max: GridCoordinate,
+) -> Option<([GridCoordinate; 4], usize)> {
+    let mut coordinates = [first_min, first_max, second_min, second_max];
+    coordinates.sort_unstable_by_key(|coordinate| coordinate.key);
+    let mut len = 1;
+    for read in 1..coordinates.len() {
+        let coordinate = coordinates[read];
+        if coordinate.key == coordinates[len - 1].key {
+            if coordinate.value.to_bits() != coordinates[len - 1].value.to_bits() {
+                return None;
+            }
+        } else {
+            coordinates[len] = coordinate;
+            len += 1;
+        }
+    }
+    Some((coordinates, len))
+}
